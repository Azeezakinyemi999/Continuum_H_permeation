# Generated sensitivity-analysis output: LHS scans, cluster tables, comparison
# matrices and the interactive figures. All of it is regenerable by re-running the
# sensitivity notebooks, and the Plotly HTML embeds a ~4.7 MB JS bundle per file
# (24 figures came to 120 MB). Keep the code and notebooks in git, not the output.
sa_results*/
*.html


#Plots
*.png

# Python bytecode
__pycache__/
*.pyc
*.pyo
release/

# Sphinx build output. The source (docs/conf.py, docs/index.md, docs/api/) IS
# tracked; only the generated HTML and doctrees are not. Rebuild with:
#     conda activate mace_env && cd docs && make html
docs/_build/

# matplotlib font cache for the docs build; lives outside _build/ so `make clean`
# does not force it to be rebuilt. See the comment in docs/conf.py.
docs/.mplcache/

# *.png above is a blanket ignore and would otherwise silently swallow any
# figure added to the docs.
!docs/_static/**/*.png
!docs/_static/**/*.svg

# Editable-install and build artefacts from pyproject.toml
*.egg-info/
build/
dist/
